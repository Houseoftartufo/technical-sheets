{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "technical-sheets-drive-webhook",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "DISPATCHER", "class_name": "DriveDispatchDebouncer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DriveDispatchDebouncer"] }
  ]
}

